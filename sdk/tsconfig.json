{
    "compilerOptions": {
      "target": "es5",
    //   "module": "commonjs",
    //   "moduleResolution": "node",
      "noImplicitAny": false,
      "removeComments": true,
      "preserveConstEnums": true,
    //   "sourceMap": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "dist",
      "declaration": true,
      "resolveJsonModule": true,
      "esModuleInterop": true,
    },
    "include": [
      "./src/**/*.ts",
      "./src/*.ts",
    ],
    "exclude": [
      "src/**/*.spec.ts",
      "src/*.spec.ts",
      "node_modules"
    ]
}